# --- Secrets: never commit ---
.env
*.key
*-key.json
service-account*.json
credentials*.json

# --- Data: never commit data to the repo (lives in GCS / Postgres) ---
data/
raw/
*.csv
*.parquet
*.xlsx
*.zip

# --- Reference materials (large, external, some copyrighted) ---
Claude_Reference/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Cloud SQL Auth Proxy binary ---
cloud-sql-proxy
cloud-sql-proxy.exe

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
Visual Studio/

# --- Claude Code ---
# Per-developer tool permissions, written when you approve a command locally.
# Personal and machine-specific, so it stays out of git. A SHARED .claude/settings.json
# (no ".local") is deliberately NOT ignored — add one if the team ever wants a common baseline.
.claude/settings.local.json

# Local scratch notes — not committed to the repo.
CLAUDE.md

