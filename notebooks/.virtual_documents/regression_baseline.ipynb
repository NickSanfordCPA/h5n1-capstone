# Select the sample of data where we keep all the positives and have at least two negatives: one at the beginning of the month and one at the end of the month. 
NEG_MONTH_QUERY = f"""
WITH ranked AS (
    SELECT fips, day, state,
           target_outbreak_next_7d,
           outbreak, own_outbreaks_7d, own_outbreaks_21d, own_outbreaks_60d,
           nbr_infected_counties_7d, nbr_infected_counties_21d, nbr_infected_counties_60d,
           nbr_infections_7d, nbr_infections_21d, nbr_infections_60d,
           nbr_wild_detections_7d, nbr_wild_detections_21d, nbr_wild_detections_60d,
           wild_detections_7d, wild_detections_21d, wild_detections_60d,
           band_count_21d, nbr_band_count_21d, has_band_coverage,
           days_since_outbreak_county, days_since_outbreak_neighbor,
           breeding_side_pressure, wintering_side_pressure,
           temp_min_7d_c, temp_max_7d_c, precip_7d_mm, precip_days_7d,
           poultry_operations, layer_operations, broiler_operations,
           turkey_operations, duck_operations, layer_inventory,
           population, pop_density_sqmi, n_neighbors, doy_sin, doy_cos,
           ROW_NUMBER() OVER (
               PARTITION BY fips, date_trunc('month', day) ORDER BY day ASC
           ) AS rn_start,
           ROW_NUMBER() OVER (
               PARTITION BY fips, date_trunc('month', day) ORDER BY day DESC
           ) AS rn_end
    FROM feature_county_day
    WHERE is_conus
      AND target_complete_7d
      AND day >= '{STUDY_START}'
      AND day <  '{SPLIT_DATE}'         -- training window only; test stays complete
      AND NOT target_outbreak_next_7d   -- negatives only -- positives are kept whole
)
SELECT * FROM ranked
WHERE rn_start = 1 OR rn_end = 1        -- first day and last day on record each month
"""

neg_monthly = pd.read_sql(NEG_MONTH_QUERY, get_engine()).drop(columns=["rn_start", "rn_end"])
neg_monthly["day"] = pd.to_datetime(neg_monthly["day"])



# Constructing Train and Test set
positives = df[df.target_outbreak_next_7d]   # every positive, train + test
