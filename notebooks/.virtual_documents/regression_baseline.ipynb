# ROC-AUC, lift vs THIS partition's own base rate), not calibrated probabilities.

X_tr_m, X_te_m = X_month_full[is_train_m], X_month_full[~is_train_m]
y_tr_m, y_te_m = y_RFLG[is_train_m], y_RFLG[~is_train_m]
