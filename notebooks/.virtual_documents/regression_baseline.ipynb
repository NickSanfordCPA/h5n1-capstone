df_monthly_sample = (
    pd.concat([positives, test_rows, neg_monthly], ignore_index=True)
      .drop_duplicates(subset=["fips", "day"])
      .sort_values(["fips", "day"])
      .reset_index(drop=True)
)

is_train_m = df_monthly_sample.day < SPLIT_DATE
month_counts = (
    neg_monthly.assign(month=neg_monthly.day.dt.to_period("M"))
