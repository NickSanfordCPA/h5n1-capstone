            "Brier score":         f"{brier_score_loss(y_te_m, p):.6f}",
            "mean predicted prob": f"{p.mean():.4%}",
        })
        print(f"{label:<38} PR-AUC={pr:.4f}  ROC-AUC={roc:.4f}  lift={pr / base_rate_m:.1f}x")

comparison_section12 = pd.DataFrame(section12_scores)
